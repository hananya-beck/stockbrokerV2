{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": []
    },
    "stockbroker": {
      "type": "stdio",
      "command": "node",
      "args": ["mcp/stockbroker.js"],
      "env": {
        "STOCKBROKER_DATA_PATH": "${STOCKBROKER_DATA_PATH:-data/funds.json}"
      }
    }
  }
}